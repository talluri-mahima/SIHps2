# LOCAL PROTOTYPE ONLY. No paid API keys required.
APP_ENV=development
AICTE_OCR_ENABLED=true
AICTE_OCR_PROVIDER=rapidocr
# Switch to paddleocr after installing requirements-paddle.in and provisioning models.
# AICTE_PADDLE_PYTHON=C:/absolute/path/to/.venv-paddle/Scripts/python.exe
# Explicit evaluation switch for PDFs with unreliable existing text layers:
AICTE_OCR_FORCE=false
AICTE_DEMO_LOGIN=true
# Windows only, enable after confirming the installed provider can scan:
# AICTE_MALWARE_SCANNER=defender
# Optional future PostgreSQL (currently unverified on this laptop):
# AICTE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/aicte
# Optional explicit PEM test/approved trust root for offline signature validation:
# AICTE_SIGNATURE_TRUST_PEM=C:/absolute/path/to/approved-root.pem
# No AICTE/bank/issuer/cloud model connection is implied by this configuration.
